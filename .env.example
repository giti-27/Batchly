# BATCHLY Environment Configuration

# Database
# For local dev / testing, SQLite or PostgreSQL can be used.
# Production uses PostgreSQL 16 (Render / Neon / Supabase).
DATABASE_URL=postgresql+psycopg2://batchly_user:batchly_pass@localhost:5432/batchly
# Fallback / Dev SQLite URL:
# DATABASE_URL=sqlite:///./batchly.db

# Environment & Security
APP_ENV=development
SECRET_KEY=batchly-super-secret-production-grade-key-2026-invariants
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Company GST Defaults (Tamil Nadu)
COMPANY_NAME=Batchly Foods Private Limited
COMPANY_GSTIN=33AABCB1234F1Z5
COMPANY_STATE_CODE=33
COMPANY_ADDRESS=Plot 42, SIDCO Industrial Estate, Thuvakudi, Tiruchirappalli, Tamil Nadu 620015
COMPANY_FY_START_MONTH=4
COMPANY_INVOICE_PREFIX=BTL

# Inventory & Production Settings
VARIANCE_TOLERANCE_PCT=3.00
FG_SAFETY_PACKETS=20
INVOICE_ROUND_OFF=false

# Firebase Authentication (Connected Project: limitless-c72be)
FIREBASE_PROJECT_ID=limitless-c72be
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Set to false to verify real Firebase ID tokens; in local dev/tests, development auth adapter is active
DEV_AUTH_BYPASS=true

# Public URLs
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
