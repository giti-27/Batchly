# Batchly local environment example
# Copy this file to .env and replace local values as needed.
# Never commit .env or real credentials.

# Database: local PostgreSQL example.
DATABASE_URL=postgresql+psycopg2://batchly_user:replace_me@localhost:5432/batchly

# Application
APP_ENV=development
# Replace this placeholder with a unique random secret for your local environment.
SECRET_KEY=replace-with-a-unique-random-secret-before-running
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Company demo defaults (synthetic evaluation data)
COMPANY_NAME=Batchly Foods Private Limited
COMPANY_GSTIN=33AABCB1234F1Z5
COMPANY_STATE_CODE=33
COMPANY_ADDRESS=Plot 42, SIDCO Industrial Estate, Thuvakudi, Tiruchirappalli, Tamil Nadu 620015
COMPANY_FY_START_MONTH=4
COMPANY_INVOICE_PREFIX=BTL

# Inventory and production
VARIANCE_TOLERANCE_PCT=3.00
FG_SAFETY_PACKETS=20
INVOICE_ROUND_OFF=false

# Firebase variables are retained for compatibility only.
# Current authentication uses backend bcrypt password verification and JWT.
FIREBASE_PROJECT_ID=limitless-c72be
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
DEV_AUTH_BYPASS=false

# Local URLs
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
